# ---------------------------------------------------------------- Godot 4.x
.godot/
.import/
export.cfg
*.translation
# Windows 构建产物（由 tools/build_windows.ps1 生成）
build/
game/bin/
# Godot 编辑器自动保存
*.tmp

# ---------------------------------------------------------------- Blender
*.blend1
*.blend2
*.blend3
*.blend4
*.blend5

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------- 生成器产物
# 管线构建的**暂存目录**不入库；
# 装进 game/assets/generated/ 的资产、manifest、seed_report 要入库——
# 运行时要能从 res:// 直接加载它们，导入检查器也要核对 sha256 与实际文件。
tools/forest_generator/output/*
!tools/forest_generator/output/.gitkeep

# ---------------------------------------------------------------- 编辑器
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
